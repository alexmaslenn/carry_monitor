# Which book this monitor watches. One monitor instance per book.
CARRY_SETUP=hlbn

# Instruments to track. Adding one here is the ONLY change needed - no code,
# no new Grafana panels (the dashboard repeats panels off this list).
CARRY_INSTRUMENTS=["DOGE"]

# Signed USD notional targeted on the PERP leg, per instrument.
# Negative = short perp / long spot, the positive-funding carry.
CARRY_TARGETS={"DOGE": -20}

# Hyperliquid MAIN account address. Public data - the info endpoint needs no key.
HL_ADDRESS=

# Binance Portfolio Margin key. READ-ONLY: this process never trades.
# Disable withdrawals and trading on it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# TimescaleDB - point at the SAME instance aegis_monitor uses so Grafana can
# read both from one datasource.
TS_DB_NAME=
TS_DB_USER=
TS_DB_PASSWORD=
TS_DB_HOST=timescaledb_aegis
TS_DB_PORT=5432

# Set to any non-empty value to stop collection without removing the container.
CARRY_DISABLED=

# Grafana admin password for the SEPARATE carry instance (port 3001).
GF_ADMIN_PASSWORD=
