# Which book this monitor watches. One monitor instance per book.
CARRY_SETUP=carry

# OPTIONAL seed. Instruments are DISCOVERED each scrape - from the robot's own
# metric labels and from positions actually held on either venue - so trading a
# new pair needs no change here. List one only to force collection while flat.
CARRY_INSTRUMENTS=[]

# Where to read the robot's declared instruments. Prometheus is preferred: it
# survives a robot restart, whereas scraping the robot goes blind when it is down.
CARRY_PROMETHEUS_URL=http://carry_prometheus:9090
CARRY_ROBOT_METRICS_URL=http://carry_tokyo:9702/metrics

# Below this notional an asset is dust rather than a position.
CARRY_DISCOVERY_MIN_USD=1

# Signed USD notional targeted on the PERP leg, per instrument.
# Negative = short perp / long spot, the positive-funding carry.
CARRY_TARGETS={"DOGE": -20}

# Hyperliquid MAIN account address. Public data - the info endpoint needs no key.
HL_ADDRESS=

# Binance Portfolio Margin key. READ-ONLY: this process never trades.
# Disable withdrawals and trading on it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bundled TimescaleDB. Created on first start from sql/ - these values define it
# rather than pointing at something that already exists. Grafana keeps its own
# state in the same instance, in a separate grafana database.
TS_DB_NAME=carry
TS_DB_USER=carry
TS_DB_PASSWORD=
TS_DB_HOST=carry_timescale
TS_DB_PORT=5432

# Set to any non-empty value to stop collection without removing the container.
CARRY_DISABLED=

# Grafana admin password. Served by Traefik on the GRAFANA_HOSTNAME below over
# https; no port is published, so this is the only way in.
GF_ADMIN_PASSWORD=

# Hostname Grafana is served on. Must resolve to this box, and the Cloudflare
# token below must be able to create a DNS TXT record for its zone.
GRAFANA_HOSTNAME=carry.example.com
ACME_EMAIL=you@example.com
CF_API_TOKEN=

# Prometheus retention. ~21 MB/day at current cardinality, so 90d is ~2 GB.
PROM_RETENTION=90d

# Private IP of the trading box running Cell. Resolved into the prometheus
# container as the hostname carry_tokyo, which is what prometheus.yml scrapes.
# The address lives here and nowhere else, so the scrape config and every stored
# series keep a stable name when the box is replaced.
ROBOT_SERVER_IP=

# Telegram bot token for alert delivery. Required if
# grafana/provisioning/alerting/carry-contactpoints.yml is present - Grafana
# refuses to start when a contact point has an empty token. Delete that file to
# run without notifications.
#
# The CHAT ID is not here. Grafana coerces interpolated provisioning values to
# numbers, which breaks a numeric chat id, so it is a literal in the contact
# point file. See the comments there. Only the token is secret; the chat id is
# useless without it.
TELEGRAM_BOT_TOKEN=
