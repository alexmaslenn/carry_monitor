{
  "editable": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Position integrity",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "description": "acc_position{type=remote} minus {type=local}. 'local' is the engine's own fill-derived tally; 'remote' is what the venue reports. They are independent paths, so a persistent gap is the ONLY evidence available that fills have been missed.\n\nThis is not hypothetical: a dropped position feed let a strategy re-issue the same order 25 times because its own position read 0.00 while 119 orders filled behind it. Non-zero here for more than a scrape or two warrants stopping the book.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "acc_position{setup=\"$setup\", host=~\"$host\", symbol=~\"$symbol\", type=\"remote\"} - on(instance, account, symbol) acc_position{setup=\"$setup\", host=~\"$host\", symbol=~\"$symbol\", type=\"local\"}",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "title": "Position drift: engine vs venue",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "description": "Repeated across every symbol the account touches, from label_values - so a new instrument appears without a dashboard edit.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "expr": "acc_position{setup=\"$setup\", host=~\"$host\", symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}} ({{type}})",
          "refId": "A"
        }
      ],
      "title": "Position by symbol",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 10,
      "panels": [],
      "title": "Liveness",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "description": "Zero on a connector that should be live means the venue link is dead even though the process is up. Every incident worth alerting on this session was silent in exactly this way.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(connector_messages{setup=\"$setup\", host=~\"$host\"}[$__rate_interval])) by (connector)",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ],
      "title": "Connector message rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "description": "binance_timeshift. recvWindow is spent on one-way latency PLUS this offset, so drift here is the leading indicator for -1021 'Timestamp outside recvWindow' - which presents as a strategy that silently never fills, not as a clock problem.\n\nThis metric already existed and was never watched; a 217ms drift from an unsynced clock broke every order until it was found by hand.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "id": 12,
      "targets": [
        {
          "expr": "binance_timeshift{setup=\"$setup\", host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Clock offset vs venue (ms)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "description": "order_delay by type. A rising tail here alongside rejections usually means the place-staleness guard is firing rather than the venue refusing.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(order_delay_bucket{setup=\"$setup\", host=~\"$host\"}[$__rate_interval])) by (le, type))",
          "legendFormat": "p50 {{type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(order_delay_bucket{setup=\"$setup\", host=~\"$host\"}[$__rate_interval])) by (le, type))",
          "legendFormat": "p95 {{type}}",
          "refId": "B"
        }
      ],
      "title": "Order delay",
      "type": "timeseries"
    },
    {
      "type": "row",
      "id": 19,
      "title": "Market data quality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "histogram",
      "id": 20,
      "title": "Quotes drift histogram — $venue",
      "description": "Distribution of quote arrival drift over the window, as the OKX colo dashboard shows it. Shape is the point: a tight cluster is a healthy feed, a long right tail means quotes are arriving late in bursts and the strategy is pricing off stale data some of the time.\n\nBuckets hold drift RELATIVE to the running minimum for this venue, so read it as spread rather than absolute latency. The median panel adds the minimum back.",
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "heatmap",
          "range": true,
          "legendFormat": "__auto",
          "expr": "sum by (le) (increase(md_${venue}_quotes_drift_bucket{setup=\"$setup\", host=~\"$host\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Quotes drift median — $venue",
      "description": "Median quote drift, with the venue's minimum added back so this is absolute rather than relative to the floor.\n\nThe floor differs enormously by venue and that is expected, not a fault: Hyperliquid sits around 151 ms from Tokyo while Binance is effectively 0. What matters is the line moving - a rising median means quotes are getting later, which shows up as the strategy hedging against a market that has already moved.",
      "datasource": {
        "type": "prometheus",
        "uid": "carry-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "$venue median",
          "expr": "histogram_quantile(0.5, sum(rate(md_${venue}_quotes_drift_bucket{setup=\"$setup\", host=~\"$host\"}[5m])) by (le)) + avg(md_${venue}_quotes_drift_min{setup=\"$setup\", host=~\"$host\"})"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "carry",
    "robot"
  ],
  "templating": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "carry-prometheus"
        },
        "definition": "label_values(acc_position, setup)",
        "includeAll": false,
        "label": "Setup",
        "multi": false,
        "name": "setup",
        "query": {
          "query": "label_values(acc_position, setup)",
          "refId": "A"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "carry-prometheus"
        },
        "definition": "label_values(acc_position{setup=\"$setup\"}, host)",
        "includeAll": true,
        "label": "Host",
        "multi": true,
        "name": "host",
        "query": {
          "query": "label_values(acc_position{setup=\"$setup\"}, host)",
          "refId": "A"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "name": "venue",
        "label": "Venue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "carry-prometheus"
        },
        "definition": "label_values(connector_messages{type=\"quotes\"}, market)",
        "query": {
          "query": "label_values(connector_messages{type=\"quotes\"}, market)",
          "refId": "A"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "carry-prometheus"
        },
        "definition": "label_values(acc_position{setup=\"$setup\", host=~\"$host\"}, symbol)",
        "includeAll": true,
        "label": "Symbol",
        "multi": true,
        "name": "symbol",
        "query": {
          "query": "label_values(acc_position{setup=\"$setup\", host=~\"$host\"}, symbol)",
          "refId": "A"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Carry Robot",
  "uid": "carry-robot"
}
