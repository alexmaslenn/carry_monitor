      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "carry-prometheus"
        },
        "definition": "label_values(acc_position{setup=\"$setup\"}, host)",
        "includeAll": true,
        "label": "Host",
        "multi": true,
        "name": "host",
        "query": {
          "query": "label_values(acc_position{setup=\"$setup\"}, host)",
          "refId": "A"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "carry-prometheus"
        },
        "definition": "label_values(acc_position{setup=\"$setup\", host=~\"$host\"}, symbol)",
        "includeAll": true,
        "label": "Symbol",
        "multi": true,
        "name": "symbol",
        "query": {
          "query": "label_values(acc_position{setup=\"$setup\", host=~\"$host\"}, symbol)",
          "refId": "A"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Carry Robot",
  "uid": "carry-robot"
}
